{
  "folders": [
    {
      "name": "SecondPassReader-Android",
      "path": "."
    }
  ],
  "settings": {
    "gradleKotlin.gradleForJava.integrationMode": "coexist",
    "gradleKotlin.taskDiscovery.autoHydrateOnActivation": "auto",
    "files.associations": {
      "*.gradle.kts": "kotlin"
    },
    "files.exclude": {
      "**/.gradle": true,
      "**/.kotlin": true,
      "**/.idea": true,
      "**/.cxx": true,
      "**/*.iml": true,
      "**/*.apk": true,
      "**/*.aab": true,
      "**/*.hprof": true,
      "**/*.log": true,
      "**/local.properties": true,
      "**/Thumbs.db": true,
      "**/.DS_Store": true
    },
    "repoStats.excludePatterns": [
      "**/.git/**",
      "**/.gradle/**",
      "**/.kotlin/**",
      "**/.idea/**",
      "**/.vscode/**",
      "**/build/**",
      "**/captures/**",
      "**/out/**"
    ],
    "gradle.autoDetect": "off",
    "java.gradle.buildServer.enabled": "off"
  }
}
