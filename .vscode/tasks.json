{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test: JVM — all",
      "type": "process",
      "command": "${workspaceFolder}/gradlew",
      "windows": {
        "command": "${workspaceFolder}\\gradlew.bat"
      },
      "args": ["test"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test: JVM — focused",
      "type": "process",
      "command": "${workspaceFolder}/gradlew",
      "windows": {
        "command": "${workspaceFolder}\\gradlew.bat"
      },
      "args": [
        ":app:testDebugUnitTest",
        "--tests",
        "${input:jvmTestFilter}"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test: Android — connected all",
      "type": "process",
      "command": "${workspaceFolder}/gradlew",
      "windows": {
        "command": "${workspaceFolder}\\gradlew.bat"
      },
      "args": [":app:connectedDebugAndroidTest"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test: Android — connected focused",
      "type": "process",
      "command": "${workspaceFolder}/gradlew",
      "windows": {
        "command": "${workspaceFolder}\\gradlew.bat"
      },
      "args": [
        ":app:connectedDebugAndroidTest",
        "-Pandroid.testInstrumentationRunnerArguments.class=${input:androidTestClass}"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test: CFI runtime — TypeScript and bundle",
      "type": "process",
      "command": "npm",
      "windows": {
        "command": "npm.cmd"
      },
      "args": ["run", "check"],
      "options": {
        "cwd": "${workspaceFolder}/tools/reader-cfi-runtime"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test: CFI — JVM",
      "type": "process",
      "command": "${workspaceFolder}/gradlew",
      "windows": {
        "command": "${workspaceFolder}\\gradlew.bat"
      },
      "args": [
        ":app:testDebugUnitTest",
        "--tests",
        "com.secondpasslibrary.reader.reader.cfi.EpubCfiTest",
        "--tests",
        "com.secondpasslibrary.reader.reader.cfi.EpubCfiNavigatorTest",
        "--tests",
        "com.secondpasslibrary.reader.reader.cfi.EpubPackageResolverTest"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test: CFI — connected runtime",
      "type": "process",
      "command": "${workspaceFolder}/gradlew",
      "windows": {
        "command": "${workspaceFolder}\\gradlew.bat"
      },
      "args": [
        ":app:connectedDebugAndroidTest",
        "-Pandroid.testInstrumentationRunnerArguments.class=com.secondpasslibrary.reader.reader.readium.cfi.ReadiumCfiJavascriptRuntimeTest"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test: CFI — connected navigator",
      "type": "process",
      "command": "${workspaceFolder}/gradlew",
      "windows": {
        "command": "${workspaceFolder}\\gradlew.bat"
      },
      "args": [
        ":app:connectedDebugAndroidTest",
        "-Pandroid.testInstrumentationRunnerArguments.class=com.secondpasslibrary.reader.reader.readium.cfi.ReadiumEpubCfiNavigatorIntegrationTest"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test: CFI — connected prefix parity",
      "type": "process",
      "command": "${workspaceFolder}/gradlew",
      "windows": {
        "command": "${workspaceFolder}\\gradlew.bat"
      },
      "args": [
        ":app:connectedDebugAndroidTest",
        "-Pandroid.testInstrumentationRunnerArguments.class=com.secondpasslibrary.reader.reader.readium.cfi.ReadiumEpubCfiNavigatorIntegrationTest#realNavigatorRoundTripsPointAndCrossMarkupRange"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Verify: all",
      "type": "process",
      "command": "${workspaceFolder}/gradlew",
      "windows": {
        "command": "${workspaceFolder}\\gradlew.bat"
      },
      "args": [
        "check",
        "assembleDebug"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "jvmTestFilter",
      "type": "promptString",
      "description": "Gradle --tests filter (class or class.method)",
      "default": "*ReaderHighlightActivationControllerTest"
    },
    {
      "id": "androidTestClass",
      "type": "promptString",
      "description": "Instrumentation class, optionally followed by #method",
      "default": "com.secondpasslibrary.reader.reader.ui.ReaderUiIntegrationTest"
    }
  ]
}
